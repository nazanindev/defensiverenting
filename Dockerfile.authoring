FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /authoring ./cmd/authoring

FROM alpine:3.20
# chromium backs the quote verifier's and checkSources' headless-render
# fallback (see internal/drafting/render.go) for sources that block a plain
# HTTP fetch. The rest are its runtime deps for headless rendering on Alpine.
RUN apk add --no-cache ca-certificates chromium nss freetype harfbuzz ttf-freefont
COPY --from=builder /authoring /authoring
EXPOSE 8081
ENTRYPOINT ["/authoring"]
